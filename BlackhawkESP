--[[
    Skrip ESP + Speedhack Sederhana (Edukasi)
    Fitur: ESP otomatis untuk NPC, Tekan 'F' untuk lari cepat, Tekan 'E' untuk terbang.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

-- Konfigurasi
local Config = {
    ESPEnabled = true,
    SpeedEnabled = false,
    FlyEnabled = false,
    SpeedMultiplier = 50, -- Kecepatan lari
}

print("[EduScript] Memulai...")

-- --- FUNGSI ESP ---
local function createESP(model)
    local rootPart = model:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    -- Hapus highlight lama jika ada
    local oldHL = rootPart:FindFirstChildWhichIsA("Highlight")
    if oldHL then oldHL:Destroy() end

    local hl = Instance.new("Highlight")
    hl.Name = "EduESP"
    hl.FillColor = Color3.fromRGB(255, 255, 0) -- Kuning
    hl.OutlineColor = Color3.fromRGB(255, 0, 0) -- Merah
    hl.Transparency = 0.5
    hl.Parent = rootPart
    return hl
end

local function updateAllESP()
    -- Cari semua model yang mengandung kata "Male" atau "NPC"
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("Model") and (string.find(v.Name, "Male") or string.find(v.Name, "NPC")) then
            if Config.ESPEnabled then
                createESP(v)
            else
                -- Hapus semua highlight jika ESP dimatikan
                local hl = v:FindFirstChildWhichIsA("Highlight")
                if hl then hl:Destroy() end
            end
        end
    end
end

-- Jalankan sekali di awal
updateAllESP()

-- Pantau model baru yang muncul
workspace.DescendantAdded:Connect(function(obj)
    if obj:IsA("Model") and (string.find(obj.Name, "Male") or string.find(obj.Name, "NPC")) then
        if Config.ESPEnabled then
            createESP(obj)
        end
    end
end)

-- --- FUNGSI SPEEDHACK & FLY ---
local function toggleSpeed()
    Config.SpeedEnabled = not Config.SpeedEnabled
    local char = player.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local humanoid = char:FindFirstChild("Humanoid")
        if hrp and humanoid then
            if Config.SpeedEnabled then
                humanoid.WalkSpeed = humanoid.WalkSpeed + Config.SpeedMultiplier
                print("[EduScript] Speed ON")
            else
                humanoid.WalkSpeed = 16 -- Kecepatan normal Roblox
                print("[EduScript] Speed OFF")
            end
        end
    end
end

local function toggleFly()
    Config.FlyEnabled = not Config.FlyEnabled
    local char = player.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            if Config.FlyEnabled then
                hrp.Anchored = true -- Cara sederhana untuk "terbang"
                print("[EduScript] Fly ON")
            else
                hrp.Anchored = false
                print("[EduScript] Fly OFF")
            end
        end
    end
end

-- --- INPUT HANDLER ---
game:GetService("UserInputService").InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end -- Abaikan jika sedang mengetik di GUI

    if input.KeyCode == Enum.KeyCode.E then
        toggleFly()
    elseif input.KeyCode == Enum.KeyCode.F then
        toggleSpeed()
    elseif input.KeyCode == Enum.KeyCode.RightShift then
        Config.ESPEnabled = not Config.ESPEnabled
        updateAllESP()
        print("[EduScript] ESP Toggle:", Config.ESPEnabled)
    end
end)

print("[EduScript] Selesai dimuat! (E=Fly, F=Speed, RightShift=ESP)")
