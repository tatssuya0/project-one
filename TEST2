--[[
    Blackhawk Rescue Mission 5 - ESP Optimasi
    Berdasarkan skrip: https://rawscripts.net/raw/Blackhawk-Rescue-Mission-5-Player-ESP-Works-for-NPCs-177985
    Fitur: 
    - ESP untuk semua model dengan Humanoid (Player & NPC)
    - Player = Hijau, NPC = Merah
    - Tombol RightShift untuk Toggle ESP
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer

-- === KONFIGURASI ===
local ESPEnabled = true
local ESPList = {} -- Untuk menyimpan semua highlight yang dibuat

print("[ESP] Memulai...")

-- === FUNGSI UTAMA ===
local function isPlayerCharacter(model)
    -- Cek apakah model adalah karakter pemain asli
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character == model then
            return true
        end
    end
    return false
end

local function ensureESP(model)
    -- Hanya proses model yang memiliki Humanoid (karakter)
    if not model:IsA("Model") then return end
    if not model:FindFirstChild("Humanoid") then return end
    
    -- Cari part untuk ditempeli highlight
    local rootPart = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
    if not rootPart then return end
    
    -- Cek apakah sudah ada highlight
    local existingHL = rootPart:FindFirstChild("AutoESP")
    if existingHL then 
        -- Update warna jika perlu (misal player berubah jadi NPC? tidak mungkin sih)
        return 
    end
    
    -- Buat highlight baru
    local hl = Instance.new("Highlight")
    hl.Name = "AutoESP"
    hl.Transparency = 0.4
    hl.Size = Vector3.new(2.5, 4.5, 2.5)
    
    -- Warna: Hijau untuk Player, Merah untuk NPC
    if isPlayerCharacter(model) then
        hl.FillColor = Color3.fromRGB(0, 255, 0)   -- Hijau
        hl.OutlineColor = Color3.fromRGB(0, 150, 0)
    else
        hl.FillColor = Color3.fromRGB(255, 0, 0)   -- Merah
        hl.OutlineColor = Color3.fromRGB(150, 0, 0)
    end
    
    hl.Parent = rootPart
    table.insert(ESPList, hl)
end

local function updateAllESP()
    -- Hapus semua ESP yang ada
    for _, hl in ipairs(ESPList) do
        if hl and hl.Parent then
            hl:Destroy()
        end
    end
    ESPList = {}
    
    if not ESPEnabled then return end
    
    -- Cari semua model dengan Humanoid di workspace
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") then
            ensureESP(obj)
        end
    end
end

-- === EVENT LISTENER ===
-- Jalankan pertama kali
updateAllESP()

-- Pantau objek baru
workspace.DescendantAdded:Connect(function(obj)
    if obj:IsA("Model") and obj:FindFirstChild("Humanoid") then
        task.wait(0.1)
        updateAllESP()
    end
end)

-- Pantau objek dihapus
workspace.DescendantRemoving:Connect(function(obj)
    if obj:IsA("Model") and obj:FindFirstChild("Humanoid") then
        updateAllESP()
    end
end)

-- Pantau player baru
Players.PlayerAdded:Connect(function()
    task.wait(0.5)
    updateAllESP()
end)

-- === TOGGLE ESP ===
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.RightShift then
        ESPEnabled = not ESPEnabled
        updateAllESP()
        print("[ESP] ESP Toggle:", ESPEnabled)
    end
end)

print("[ESP] Selesai dimuat! (RightShift = Toggle ESP)")
print("[ESP] Player = Hijau | NPC = Merah")
